generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                   String                   @id @default(cuid())
  name                 String
  createdAt            DateTime                 @default(now())
  feedback             Feedback[]
  reports              Report[]
  themes               Theme[]
  channels             Channel[]
  users                User[]
  googleFormIntegration GoogleFormIntegration?
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspaceId  String
  reports      Report[]
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment?
  sentimentScore Float?
  status         Status          @default(NEW)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspaceId    String
  embedding      Embedding?
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbackThemes FeedbackTheme[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, channel])
  @@index([workspaceId, deletedAt])
}

model Theme {
  id             String          @id @default(cuid())
  name           String
  description    String?
  color          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  workspaceId    String
  feedbackThemes FeedbackTheme[]
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@unique([workspaceId, name])
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@unique([workspaceId, name])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float    @default(0)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Float[]
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id            String    @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   Json
  createdAt     DateTime  @default(now())
  workspaceId   String
  generatedById String
  generatedBy   User      @relation(fields: [generatedById], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum Status {
  NEW
  REVIEWED
  ACTIONED
}

model OtpToken {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  otpHash    String
  // For SIGNUP only: the pending signup data (name, email, hashed password,
  // workspace name) so the User/Workspace are created only after the OTP
  // is verified. Never stores the raw password.
  payload    Json?
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@index([email, purpose, consumedAt])
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

// Short-lived, single-use credential issued only after a PASSWORD_RESET OTP
// has been verified. The raw token is shown to the client once and never
// stored; only its hash is kept here.
model PasswordResetToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model GoogleFormIntegration {
  id           String    @id @default(cuid())
  workspaceId  String    @unique
  webhookSecret String   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}